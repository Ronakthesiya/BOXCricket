@section scripts{
    <script>
        const slider = document.getElementById('slider');
        const nextBtn = document.getElementById('next');
        const prevBtn = document.getElementById('prev');
        const sliderContainer = document.getElementById('sliderContainer');
        let index = 0;
        let autoSlide;

        function slide(direction) {
            const cards = document.querySelectorAll('.card');
            const cardWidth = cards[0].offsetWidth + 20;
            if (direction === 'next') {
                index = (index + 1) % (cards.length-2);
            } else {
                index = (index - 1 + cards.length) % cards.length;
            }
            slider.style.transform = `translateX(${-index * cardWidth}px)`;
        }

        function startAutoSlide() {
            autoSlide = setInterval(() => slide('next'), 2000);
        }

        function stopAutoSlide() {
            console.log("Stop")
            clearInterval(autoSlide);
        }

        nextBtn.addEventListener('click', () => {
            slide('next');
            stopAutoSlide();
            startAutoSlide();
        });
        prevBtn.addEventListener('click', () => {
            slide('prev');
            stopAutoSlide();
            startAutoSlide();
        });

        sliderContainer.addEventListener('mouseenter', stopAutoSlide);
        sliderContainer.addEventListener('mouseleave', startAutoSlide);

        startAutoSlide();
    </script>

     @* for venues *@
    <style>
        
        .slider-container {
            width: 100%;
            overflow: hidden;
            position: relative;
        }

        .slider {
            display: flex;
            transition: transform 0.5s ease-in-out;
        }

        .card {
            min-width: 350px;
            margin: 15px;
            padding: 15px;
            background: white;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            border-radius: 12px;
            text-align: left;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-10px);
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
            }

            .card img {
                width: 100%;
                height: 250px;
                object-fit: cover;
                border-radius: 10px;
            }

        .category {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(0, 0, 255, 0.1);
            color: #0033cc;
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: bold;
        }

        .card h3 {
            margin: 0px 0 10px;
            font-size: 18px;
            display: -webkit-box;
            -webkit-line-clamp: 2; /* Limit to 3 lines */
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            max-height: 4.5em; /* Adjust based on font size */
            line-height: 2.0em; /* Ensures 3 lines */
        }

        .card h2 {
            margin: 13px 0 10px;
        }

        .read-more {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 14px;
            color: #0033cc;
            font-weight: bold;
            cursor: pointer;
            transition: color 0.3s;
        }

            .read-more:hover {
                color: #ff6600;
            }

        .controls {
            position: absolute;
            top: 50%;
            width: 100%;
            display: flex;
            justify-content: space-between;
            transform: translateY(-50%);
        }

            .controls button {
                background: rgba(0, 0, 0, 0.2);
                color: white;
                border: none;
                padding: 10px 15px;
                cursor: pointer;
                border-radius: 50%;
                transition: background 0.3s;
            }

                .controls button:hover {
                    background: rgba(0, 0, 0, 0.4);
                }

        

        
    </style>

    <style>
        .timeline {
            position: relative;
            padding: 40px 0;
            max-width: 800px;
            margin: auto;
        }

        .timeline-item {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 40px;
        }

            .timeline-item:nth-child(even) {
                flex-direction: row-reverse;
            }

        .timeline-content {
            width: 60%;
        }

        /* Icons */
        .timeline-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: bold;
            position: relative;
            z-index: 2;
        }

        /* Path Lines */
        .timeline-line {
            position: absolute;
            width: 4px;
            background: #ddd;
            top: 50%;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1;
            transition: height 1s ease-in-out;
        }

        .line-1 {
            height: 0;
            animation: fill-line 1s ease-out forwards 0.5s;
        }

        .line-2 {
            height: 0;
            animation: fill-line 1s ease-out forwards 1.5s;
        }
    </style>

}