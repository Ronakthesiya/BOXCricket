    <style>
        .timeline-container::-webkit-scrollbar {
            height: 5px;
        }

        .timeline-container::-webkit-scrollbar-track {
            background-color: #e5e0e0;
        }

        .timeline-container::-webkit-scrollbar-thumb {
            background-color: #979292;
            border-radius: 5px;
        }

            .timeline-container::-webkit-scrollbar-thumb:hover {
                background-color: #636363;
            }

        .time-selector {
            display: flex;
            align-items: center;
            justify-content: space-around;
            width: 90%;
            max-width: 500px;
            margin-bottom: 20px;
            padding: 10px;
            background: white;
            border-radius: 8px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

            .time-selector button {
                background: none;
                border: 1px solid #ccc;
                border-radius: 50%;
                width: 30px;
                height: 30px;
                cursor: pointer;
            }

        .timeline-container {
            position: relative;
            width: 100%;
            overflow-x: auto;
            background-color: white;
            padding: 20px 0px;
            border-radius: 8px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

        .timeline {
            display: flex;
            position: relative;
        }

        .hour {
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            color: black;
            position: relative;
            min-width: 50px;
        }

            .hour.unbooked::before {
                position: absolute;
                top: 50%;
                left: 0;
                width: 100%;
                height: 5px;
                background-color: green;
                transform: translateY(-50%);
            }

            .hour.booked::before {
                position: absolute;
                top: 50%;
                left: 0;
                width: 100%;
                height: 5px;
                background-color: red;
                transform: translateY(-50%);
            }

        .arrow-indicator {
            position: absolute;
            width: 0;
            height: 0;
            border-left: 10px solid transparent;
            border-right: 10px solid transparent;
            border-top: 10px solid black;
            top: 40px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1;
        }


        .dataTables_filter {
            display: flex;
            justify-content: end;
        }

        #basic-datatables_paginate{
            display: flex;
            justify-content: end;
        }

    </style>

