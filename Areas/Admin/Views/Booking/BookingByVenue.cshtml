@using Newtonsoft.Json
@model IEnumerable<BOXCricket.Models.BookingModel>

@{
    ViewData["Title"] = "BookingByVenue";
}


<div class="page-inner">
    <div class="page-header">
        <h3 class="fw-bold mb-3">Venues</h3>
        <ul class="breadcrumbs mb-3">
            <li class="nav-home">
                <a asp-action="Index" asp-controller="Home">
                    <i class="fa-solid fa-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="bi bi-chevron-right"></i>
            </li>
            <li class="nav-item">
                <a href="">Bookings of Venue</a>
            </li>

        </ul>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Venue : @ViewData["VenueName"]</h4>
                </div>
                <div class="card-body">
                    <div class="date-picker d-flex justify-content-center align-items-center gap-3">
                        <button id="minusBtn" class="btn"><i class="fa-solid fa-minus"></i></button>
                        <input type="date" id="dateInput" name="dateInput" class="form-control text-center" style="width: 200px;">
                        <button id="plusBtn" class="btn"><i class="fa-solid fa-plus"></i></button>
                    </div>

                    <!-- Timeline -->
                    <div class="timeline-container">
                        @* <div class="arrow-indicator"></div> *@
                        <div class="timeline" id="timeline">
                            <!-- JavaScript will populate the hours dynamically -->
                        </div>
                    </div>

                    <div class="table-responsive mt-5">
                        <div id="basic-datatables_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                            <div class="row">
                                <div class="col-sm-12">
                                    <table id="basic-datatables" class="display table table-striped table-hover dataTable" role="grid" aria-describedby="basic-datatables_info">
                                        <thead>
                                            <tr role="row">
                                                <th class="sorting" tabindex="0" aria-controls="basic-datatables" rowspan="1" colspan="1" aria-label="Name: activate to sort column descending" aria-sort="descending">@Html.DisplayNameFor(model => model.BookingDate)</th>
                                                <th class="sorting" tabindex="0" aria-controls="basic-datatables" rowspan="1" colspan="1" aria-label="Position: activate to sort column ascending">@Html.DisplayNameFor(model => model.User.Name)</th>
                                                <th class="sorting" tabindex="0" aria-controls="basic-datatables" rowspan="1" colspan="1" aria-label="Office: activate to sort column ascending">@Html.DisplayNameFor(model => model.Venue.Name)</th>
                                                <th class="" tabindex="0" aria-controls="basic-datatables" rowspan="1" colspan="1" aria-label="Age: activate to sort column">Time</th>
                                                <th class="" tabindex="0" aria-controls="basic-datatables" rowspan="1" colspan="1" aria-label="Age: activate to sort column">@Html.DisplayNameFor(model => model.TotalAmount)</th>
                                                <th class="" tabindex="0" aria-controls="basic-datatables" rowspan="1" colspan="1" aria-label="Age: activate to sort column">@Html.DisplayNameFor(model => model.Status)</th>
                                                <th class="" tabindex="0" aria-controls="basic-datatables" rowspan="1" colspan="1" aria-label="Age: activate to sort column" style="width: 101.0374px;">@Html.DisplayNameFor(model => model.CreatedAt)</th>
                                        </thead>

                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr role="row" class="odd">
                                                    <td>@item.BookingDate.ToString("dd-MM-yyyy")</td>

                                                    <td>@item.User?.Name</td>
                                                    <td>@item.Venue?.Name</td>
                                                    <td>
                                                        @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                                                    </td>
                                                    <td>@Html.DisplayFor(modelItem => item.TotalAmount)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                                    <td>@item.CreatedAt.ToString("g")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts {
    <script>


            const timeline = document.getElementById("timeline");
            // timeline.removeChild

            // Mock data: Define booked hours
            // const bookedHours = ["10:00"];
            bookedHours = @Html.Raw(Json.Serialize(TempData["BookedSloats"]));

            const hours = [
                "1:00", "2:00", "3:00", "4:00", "5:00",
                "6:00", "7:00", "8:00", "9:00", "10:00", "11:00",
                "12:00", "13:00", "14:00", "15:00", "16:00", "17:00",
                "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"
            ];

            var flag = 0;

            hours.forEach(hour => {
                const hourDiv = document.createElement("div");
                const div1 = document.createElement("div");
                const div2 = document.createElement("div");
                const div3 = document.createElement("div");


                div1.classList.add("d-flex");
                div1.classList.add("flex-row");
                div1.classList.add("w-100");
                div1.classList.add("h-50");
                div1.classList.add("pt-1");


                div2.classList.add("w-50");
                div2.classList.add("h-100");
                div2.classList.add("px-3");
                div2.classList.add("mt-1");
                div2.classList.add("border-start-0");
                div2.classList.add("border-top-0");
                div2.classList.add("border-bottom-0");
                div2.classList.add("border");
                div2.classList.add("border-dark");
                div1.appendChild(div2);

                div3.classList.add("w-50");
                div3.classList.add("h-100");
                div3.classList.add("px-3");
                div3.classList.add("mt-1");
                div3.classList.add("border-end-0");
                div3.classList.add("border-top-0");
                div3.classList.add("border-bottom-0");
                div3.classList.add("border");
                div3.classList.add("border-dark");

                div1.appendChild(div3);


                hourDiv.classList.add("hour");

                hourDiv.classList.add("text-center");


                if (flag == 0) {
                    div2.classList.add("bg-info");
                } else {
                    div2.classList.add("bg-danger");
                }

                if (bookedHours.includes(hour)) {
                    div3.classList.add("bg-danger");
                    flag = 1;
                    hourDiv.classList.add("booked");
                } else {
                    flag = 0;
                    div3.classList.add("bg-info");
                    hourDiv.classList.add("unbooked");
                }


                hourDiv.innerText = hour;
                hourDiv.appendChild(div1);
                timeline.appendChild(hourDiv);


            });
        

        // Time Selector Logic
        let timeIndex = @DateTime.Now.Hour - 1; // Starting with 12:00
        const timeElement = document.getElementById("selectedTime");

        document.getElementById("incrementTime").addEventListener("click", () => {
            timeIndex = (timeIndex + 1) % hours.length; // Loop back to the start
            updateTime();
        });

        document.getElementById("decrementTime").addEventListener("click", () => {
            timeIndex = (timeIndex - 1 + hours.length) % hours.length; // Loop back from the end
            updateTime();
        });

        function updateTime() {
            timeElement.innerText = hours[timeIndex];
            centerArrowOnTime();
        }

        // Center Arrow on Selected Time
        const arrowIndicator = document.querySelector(".arrow-indicator");

        function centerArrowOnTime() {
            const hourElements = document.querySelectorAll(".hour");
            const currentTime = hours[timeIndex];

            hourElements.forEach((hour, index) => {
                if (hour.innerText === currentTime) {
                    const offset = hour.offsetLeft + hour.offsetWidth / 2;
                    timeline.scrollLeft = offset - timeline.offsetWidth / 2;
                    arrowIndicator.style.left = `${offset}px`;
                }
            });
        }

        // Initial Centering
        centerArrowOnTime();
    </script>


    <script>
        // Initialize the date input with today's date
        const dateInput = document.getElementById("dateInput");
        const plusBtn = document.getElementById("plusBtn");
        const minusBtn = document.getElementById("minusBtn");

        // Helper function to format the date as YYYY-MM-DD
        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, "0");
            const day = String(date.getDate()).padStart(2, "0");
            return `${year}-${month}-${day}`;
        }

        // Set today's date as the default
        let currentDate = new Date();
        dateInput.value = formatDate(currentDate);

        // Add 1 day
        plusBtn.addEventListener("click", () => {
            // currentDate.setDate(currentDate.getDate() + 1);
            // dateInput.value = formatDate(currentDate);

            let currentDate = new Date(dateInput.value); // Convert input value to Date object
            currentDate.setDate(currentDate.getDate() + 1); // Add 1 day
            dateInput.value = currentDate.toISOString().split("T")[0]; // Format as YYYY-MM-DD
        });

        // Subtract 1 day
        minusBtn.addEventListener("click", () => {
            // currentDate.setDate(currentDate.getDate() - 1);
            // dateInput.value = formatDate(currentDate);

            let currentDate = new Date(dateInput.value);
            currentDate.setDate(currentDate.getDate() - 1); // Subtract 1 day
            if (currentDate.toISOString().split("T")[0] >= dateInput.min) {
                dateInput.value = currentDate.toISOString().split("T")[0];
            }
        });

    </script> 

